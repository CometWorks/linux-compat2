<?xml version="1.0"?>
<PluginData xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="GitHubPlugin">

    <!-- The ID of your plugin, never change this -->
    <Id>linux-compat</Id>

    <!-- GitHub repository ID -->
    <RepoId>CometWorks/linux-compat2</RepoId>

    <!-- The name of your plugin that will appear in the plugin list -->
    <FriendlyName>LinuxCompat</FriendlyName>

    <!-- The author name that you want to appear in the plugin list -->
    <Author>Viktor</Author>

    <Tooltip>Linux support for Space Engineers 2</Tooltip>
    <Description>Patches Space Engineers 2 to run natively on Linux. The plugin loads automatically when needed.</Description>

    <!-- Only source code in the Directory entries listed in SourceDirectories is compiled. -->
    <SourceDirectories>
        <Directory>ClientPlugin</Directory>
    </SourceDirectories>

    <!-- Linux native dependencies. The archives are built by the linux-dependencies and
         linux-native-wrappers repositories; during development they are pulled from the
         sibling checkouts. The DXC shader compiler trio is not packaged yet and comes from
         the recompiled-game workspace. -->
    <Asset Name="LinuxDependencies"
           Path="../../se1/linux-dependencies/dist/se2-dependencies.tar.gz"
           Extract="true"
           Placement="Bin"
           Platforms="Linux" />

    <Asset Name="SteamDependencies"
           Path="../../se1/linux-dependencies/dist/steam-dependencies.tar.gz"
           Extract="true"
           Placement="Bin"
           Platforms="Linux" />

    <Asset Name="NativeWrappers"
           Path="../../se1/linux-native-wrappers/dist/se2-native-wrappers.tar.gz"
           Extract="true"
           Placement="Bin"
           Platforms="Linux" />

    <!-- Bin-placed assets are copied flat next to the compiled plugin, so overlapping
         files must not be listed twice. Only the DXC shader compiler trio is taken from
         the recompiled-game workspace; DXVK and vkd3d-proton come from the archive above. -->
    <Asset Name="DxcCompiler"
           Path="../dotnet-game2-local/RenderingLibs/libdxcompiler.so"
           Placement="Bin"
           Platforms="Linux" />

    <Asset Name="Dxil"
           Path="../dotnet-game2-local/RenderingLibs/libdxil.so"
           Placement="Bin"
           Platforms="Linux" />

    <Asset Name="DxcBridge"
           Path="../dotnet-game2-local/RenderingLibs/libSE2DxcCompiler.so"
           Placement="Bin"
           Platforms="Linux" />

    <!-- Windows Desktop implementation assemblies from the .NET runtime pack. Nothing on
         the Linux code path executes them, but game assemblies and Pulsar patches reference
         WinForms types, and the runtime must be able to resolve those tokens. -->
    <Asset Name="WinDesktopStubs"
           Path="../windesktop-stubs"
           Placement="Bin"
           Platforms="Linux" />

    <Runtimes>CoreCLR</Runtimes>
    <Platforms>Linux</Platforms>
    <Hidden>true</Hidden>

    <!-- The current plugin version's commit hash -->
    <Commit>TODO</Commit>

</PluginData>
